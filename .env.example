# Copy to .env and fill in real values. .env is git-ignored; never commit the key.
# RapidAPI key for JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY

# Optional tuning
JSEARCH_DEFAULT_COUNTRY=in
JOBS_CACHE_TTL=600
JOBS_API_TIMEOUT=12

# Flask session signing key (generate with: python -c "import secrets;print(secrets.token_hex(32))")
# SECRET_KEY=
# COOKIE_SECURE=1

# Years of experience tolerated by the entry-level filter (0 = internships only)
JOBS_MAX_EXPERIENCE_YEARS=0
